# ARACHNE · Career OS Control Plane — environment configuration
# Copy to `.env` (gitignored) or set in your hosting provider's dashboard.

# Operational label (production / sandbox). Informational.
CAREER_OS_ENV=production

# --- Persistent storage roots -------------------------------------------------
# Point these at a mounted persistent volume so execution state, the ARACHNE
# index, and checkpoints survive restarts/redeploys. In the provided Docker
# image and render.yaml blueprint these default to /data/.career_os/...
CAREER_OS_EXECUTION_ROOT=.career_os/executions
CAREER_OS_ARACHNE_ROOT=.career_os/arachne
CAREER_OS_CONDUCTOR_CHECKPOINT_PATH=.career_os/conductor_runs
CAREER_OS_CONDUCTOR_IDEMPOTENCY_PATH=.career_os/conductor_idempotency.json

# --- Service token for the machine-to-machine /api/v1 read API --------------
# Leave unset to serve the ARACHNE dashboard + /api control plane tokenless.
# If set, every /api/v1 request must present it via the `X-Career-OS-Token`
# header (HMAC-compared). /healthz and the /api dashboard endpoints stay open.
# CAREER_OS_CONDUCTOR_TOKEN=

# --- Live browser execution (EXPLICIT opt-in) --------------------------------
# Leave unset for safe deterministic fixture execution (no employer contact).
# Set to 1/true ONLY when Playwright+Chromium are installed in the image/host.
CAREER_OS_ENABLE_BROWSER=

# --- Optional AI/provider enrichment -----------------------------------------
# All stage agents are deterministic/offline; these only add optional model
# enrichment and are not required for the app to run.
# CAREER_OS_OLLAMA_URL=http://localhost:11434
# GEMINI_MODEL=gemini-3.6-flash

# --- Optional delegated browser execution via the user's JobPilot terminal ----
# Mutually exclusive with native Playwright. Requires credentials.
# JOBPILOT_API=
# JOBPILOT_API_TOKEN=
# JOBPILOT_TERMINAL_URL=
# JOBPILOT_PROVIDER=
# JOBPILOT_TIMEOUT_SECONDS=
# JOBPILOT_POLL_SECONDS=
